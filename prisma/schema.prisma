// prisma/schema.prisma
// PUBLIC REPO NOTE: this file defines structure only — no credentials belong
// here. The actual connection string lives in `.env` (gitignored) and is
// read by `prisma.config.ts` at the project root — Prisma 7 no longer
// allows `url` inside this file's datasource block.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) required models ---------------------------------
// Shape follows the official Prisma adapter schema exactly:
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models -----------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientName    String
  clientEmail   String
  client        Json // ClientInfo — full snapshot (incl. address); clientName/clientEmail duplicated above for fast list-view queries
   businessInfo  Json // BusinessInfo — snapshot at time of creation, not a live reference
  lineItems     Json // LineItem[]
  taxRate       Decimal        @db.Decimal(5, 2)
  currency      String         @db.VarChar(3)
  dueDate       DateTime?
  notes         String?        @db.Text
  paymentMethod Json // PaymentMethods — see src/types/invoice.ts for the shape
  status        InvoiceStatus  @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
